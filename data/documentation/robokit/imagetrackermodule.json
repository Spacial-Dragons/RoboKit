{"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"This module leverages ARKit to track one or more reference images added to an AR Resource Group in your asset catalog. It exposes two main properties: ","type":"text"},{"type":"codeVoice","code":"rootTransform"},{"type":"text","text":", which represents the calculated center of all tracked images, and "},{"code":"trackedImagesTransform","type":"codeVoice"},{"text":", which represents the positions of each individual image.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Setup","type":"heading","anchor":"Setup"},{"text":"Configure Permissions","type":"heading","level":3,"anchor":"Configure-Permissions"},{"type":"paragraph","inlineContent":[{"text":"Add the following key to your app’s Info.plist file:","type":"text"}]},{"type":"codeListing","syntax":"xml","code":["<key>NSWorldSensingUsageDescription<\/key>","<string>This app requires world sensing capabilities to track reference images.<\/string>"]},{"level":3,"type":"heading","text":"Create AR Reference Image Group","anchor":"Create-AR-Reference-Image-Group"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Open Xcode and go to your asset catalog."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add a new ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"AR Resource Group"}]},{"text":" (e.g., “AR Resources”).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add your tracking images and set their "},{"type":"strong","inlineContent":[{"text":"physical size","type":"text"}]},{"type":"text","text":" correctly."}]}]}]},{"text":"Define Tracking Images in Code","type":"heading","anchor":"Define-Tracking-Images-in-Code","level":3},{"type":"paragraph","inlineContent":[{"text":"Each image should be described using its name and a root offset from the reference point in RealityKit coordinates:","type":"text"}]},{"syntax":"swift","code":["import RoboKit","","let trackingImages: [TrackingImage] = [","    TrackingImage(imageName: \"TrackingImage-1\", rootOffset: .init(x: -0.1135, y: 0, z: 0.175)),","    TrackingImage(imageName: \"TrackingImage-2\", rootOffset: .init(x: 0.1135, y: 0, z: -0.175))","]"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"identifier":"RealityKit-Coordinate-System.png","type":"image"}]},{"name":"Important","type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tracking image quality is critical. Avoid compressed images, images with too few or too many geometric features, or with repeating patterns."}]}]},{"name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"Ensure all tracking images share the same physical orientation.","type":"text"}]}],"type":"aside"},{"name":"Note","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"If using multiple images, the "},{"code":"rootOffset","type":"codeVoice"},{"type":"text","text":" values are used to calculate the center. If using one image, set its offset to "},{"type":"codeVoice","code":".zero"},{"text":".","type":"text"}],"type":"paragraph"}]},{"type":"heading","text":"Initialize Image Tracker","anchor":"Initialize-Image-Tracker","level":3},{"type":"paragraph","inlineContent":[{"text":"Initialize the ","type":"text"},{"type":"reference","identifier":"doc:\/\/robokit.RoboKit\/documentation\/RoboKit\/ImageTracker","isActive":true},{"type":"text","text":" by providing the resource group name and your array of tracking images:"}]},{"syntax":"swift","code":["@State private var imageTracker: RoboKit.ImageTracker = .init(","    arResourceGroupName: \"AR Resources\",","    images: trackingImages",")"],"type":"codeListing"},{"level":2,"anchor":"Usage","text":"Usage","type":"heading"},{"anchor":"Root-Transform","text":"Root Transform","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Represents the central position between all tracked images.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":[".onChange(of: imageTracker.rootTransform) {","    print(imageTracker.rootTransform)","}"]},{"text":"Tracked Images Transform","anchor":"Tracked-Images-Transform","level":3,"type":"heading"},{"inlineContent":[{"text":"Represents the positions of each tracked image:","type":"text"}],"type":"paragraph"},{"code":[".onChange(of: imageTracker.trackedImagesTransform) {","    print(imageTracker.trackedImagesTransform)","}"],"syntax":"swift","type":"codeListing"},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"These values update approximately once per second.","type":"text"}]}],"style":"note"},{"name":"Warning","type":"aside","style":"warning","content":[{"type":"paragraph","inlineContent":[{"text":"Image tracking is not supported in the simulator.","type":"text"}]}]},{"style":"important","content":[{"inlineContent":[{"text":"On visionOS, only one image can be tracked at a time, even if more are visible.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Important"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/robokit\/imagetrackermodule"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"The Image Tracker module provides functionality for detecting and tracking images in the physical environment using ARKit and visionOS."}],"metadata":{"title":"Image Tracker","modules":[{"name":"RoboKit"}],"images":[{"identifier":"ImageTrackerModuleCard.png","type":"card"}],"roleHeading":"Article","role":"article"},"hierarchy":{"paths":[["doc:\/\/robokit.RoboKit\/documentation\/RoboKit"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","identifier":{"url":"doc:\/\/robokit.RoboKit\/documentation\/RoboKit\/ImageTrackerModule","interfaceLanguage":"swift"},"sections":[],"references":{"ImageTrackerModuleCard.png":{"variants":[{"url":"\/images\/robokit.RoboKit\/ImageTrackerModuleCard.png","traits":["1x","light"]}],"type":"image","alt":null,"identifier":"ImageTrackerModuleCard.png"},"RealityKit-Coordinate-System.png":{"variants":[{"url":"\/images\/robokit.RoboKit\/RealityKit-Coordinate-System.png","traits":["1x","light"]}],"type":"image","alt":"RealityKit coordinate system","identifier":"RealityKit-Coordinate-System.png"},"doc://robokit.RoboKit/documentation/RoboKit":{"identifier":"doc:\/\/robokit.RoboKit\/documentation\/RoboKit","type":"topic","kind":"symbol","images":[{"identifier":"RoboKitLogo.png","type":"icon"}],"abstract":[{"type":"text","text":"RoboKit is a framework designed to facilitate the integration between visionOS applications and robotics software."}],"url":"\/documentation\/robokit","title":"RoboKit","role":"collection"},"doc://robokit.RoboKit/documentation/RoboKit/ImageTracker":{"url":"\/documentation\/robokit\/imagetracker","identifier":"doc:\/\/robokit.RoboKit\/documentation\/RoboKit\/ImageTracker","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImageTracker","kind":"identifier"}],"abstract":[{"text":"The Image Tracker module provides functionality for detecting and tracking images","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"in the physical environment using ARKit and visionOS."},{"type":"text","text":" "},{"text":"A class responsible for tracking images using ARKit and providing corresponding transformation data.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"It handles the initialization of AR sessions, image tracking, and updates for tracked anchors."}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"ImageTracker","kind":"identifier"}],"title":"ImageTracker"},"RoboKitLogo.png":{"variants":[{"url":"\/images\/robokit.RoboKit\/RoboKitLogo.png","traits":["1x","light"]},{"url":"\/images\/robokit.RoboKit\/RoboKitLogo~dark.png","trait