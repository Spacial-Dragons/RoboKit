{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/robokit.RoboKit\/documentation\/RoboKit"]]},"identifier":{"url":"doc:\/\/robokit.RoboKit\/documentation\/RoboKit\/InputEntity","interfaceLanguage":"swift"},"kind":"article","abstract":[{"type":"text","text":"The Input Entity module provides a visual and interactive way to control a robot’s end effector in 3D space using visionOS."}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The Input Entity module creates a virtual object that can be positioned and rotated in 3D space to represent the desired pose (position and orientation) of a robot’s end effector. This module provides coordinate transformations between visionOS (RealityKit) and ROS (Robot Operating System) coordinate systems, making it easy to integrate with robotic applications.","type":"text"}]},{"type":"heading","anchor":"Setup","text":"Setup","level":2},{"type":"heading","level":3,"anchor":"Initialize-Input-Entity-Manager","text":"Initialize Input Entity Manager"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of the ","type":"text"},{"identifier":"doc:\/\/robokit.RoboKit\/documentation\/RoboKit\/InputEntityManager","isActive":true,"type":"reference"},{"type":"text","text":" to track and update the position and orientation of the Input Entity:"}]},{"syntax":"swift","code":["import RoboKit","","@State private var inputEntityManager = InputEntityManager()"],"type":"codeListing"},{"text":"Add Input Entity to RealityKit Scene","level":3,"anchor":"Add-Input-Entity-to-RealityKit-Scene","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the Input Entity to your RealityKit scene with the appropriate parent and rootPoint entities:"}]},{"type":"codeListing","code":[".onAppear {","    inputEntityManager.addInputEntity(parentEntity: parentEntity, rootPoint: rootPoint)","}"],"syntax":"swift"},{"anchor":"Usage","text":"Usage","type":"heading","level":2},{"text":"Control Input Entity Position","type":"heading","anchor":"Control-Input-Entity-Position","level":3},{"type":"paragraph","inlineContent":[{"text":"Update the position of the Input Entity using a drag gesture:","type":"text"}]},{"syntax":"swift","code":["\/\/ Add Input Entity Drag Gesture recognition and handling.",".inputEntityDragGesture(","    parentEntity: parentEntity,","    rootPoint: rootPoint,","    inputEntityManager: inputEntityManager",")"],"type":"codeListing"},{"anchor":"Control-Input-Entity-Orientation","text":"Control Input Entity Orientation","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Update the orientation of the Input Entity using Euler angles:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Set orientation using roll, pitch, and yaw","inputEntityManager.inputEntityEulerAngles = [","    .roll: Float.pi \/ 4,   \/\/ 45 degrees","    .yaw: 0,","    .pitch: Float.pi \/ 6   \/\/ 30 degrees","]"]},{"type":"heading","text":"Track Input Entity Position","level":3,"anchor":"Track-Input-Entity-Position"},{"inlineContent":[{"type":"text","text":"Monitor the position of the Input Entity relative to a root point in your scene:"}],"type":"paragraph"},{"code":["\/\/ Get position in ROS coordinate system","if let position = inputEntityManager.getInputEntityPosition(relativeToRootPoint: rootEntity) {","    print(\"Input Entity position (ROS): \\(position)\")","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Track Input Entity Orientation","anchor":"Track-Input-Entity-Orientation","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Monitor the orientation of the Input Entity relative to a root point in your scene:"}]},{"code":["\/\/ Get position in ROS coordinate system","if let orientation = inputEntityManager.getInputEntityRotation(relativeToRootPoint: rootEntity) {","    print(\"Input Entity orientation (ROS): \\(orientation)\")","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Display-Input-Entity-Data","text":"Display Input Entity Data","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Add the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/robokit.RoboKit\/documentation\/RoboKit\/InputEntityPositionView"},{"type":"text","text":" to your SwiftUI interface to display the current position:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["InputEntityPositionView(relativeToRootPoint: rootEntity)"]},{"type":"heading","level":3,"text":"Enable Interactive Control","anchor":"Enable-Interactive-Control"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Allow users to adjust the Input Entity using the rotation sliders:"}]},{"code":["VStack {","    InputEntityRotationSlider(eulerAngle: .roll)","    InputEntityRotationSlider(eulerAngle: .pitch)","    InputEntityRotationSlider(eulerAngle: .yaw)","}"],"type":"codeListing","syntax":"swift"},{"name":"Important","type":"aside","style":"important","content":[{"inlineContent":[{"type":"text","text":"Remember that the Input Entity uses different coordinate systems for RealityKit and ROS. Position and rotation values are automatically converted when using the appropriate getter methods."}],"type":"paragraph"}]}]}],"metadata":{"roleHeading":"Article","modules":[{"name":"RoboKit"}],"role":"article","images":[{"type":"card","identifier":"InputEntityCard.png"}],"title":"Input Entity"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/robokit\/inputentity"]}],"references":{"InputEntityCard.png":{"identifier":"InputEntityCard.png","alt":null,"type":"image","variants":[{"url":"\/images\/robokit.RoboKit\/InputEntityCard.png","traits":["1x","light"]}]},"doc://robokit.RoboKit/documentation/RoboKit":{"identifier":"doc:\/\/robokit.RoboKit\/documentation\/RoboKit","type":"topic","kind":"symbol","images":[{"identifier":"RoboKitLogo.png","type":"icon"}],"abstract":[{"type":"text","text":"RoboKit is a framework designed to facilitate the integration between visionOS applications and robotics software."}],"url":"\/documentation\/robokit","title":"RoboKit","role":"collection"},"doc://robokit.RoboKit/documentation/RoboKit/InputEntityManager":{"type":"topic","title":"InputEntityManager","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"InputEntityManager"}],"role":"symbol","abstract":[{"type":"text","text":"A class responsible for managing the Input Entity, which represents the desired position"},{"type":"text","text":" "},{"type":"text","text":"and orientation of a robot’s end effector in a 3D environment."}],"identifier":"doc:\/\/robokit.RoboKit\/documentation\/RoboKit\/InputEntityManager","url":"\/documentation\/robokit\/inputentitymanager","kind":"symbol","navigatorTitle":[{"text":"InputEntityManager","kind":"identifier"}]},"RoboKitLogo.png":{"identifier":"RoboKitLogo.png","alt":"RoboKit logo.","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/robokit.RoboKit\/RoboKitLogo.png"},{"url":"\/images\/robokit.RoboKit\/RoboKitLogo~dark.png","traits":["1x","dark"]}]},"doc://robokit.RoboKit/documentation/RoboKit/InputEntityPositionView":{"role":"symbol","url":"\/documentation\/robokit\/inputentitypositionview","navigatorTitle":[{"kind":"identifier","text":"InputEntityPositionView"}],"abstract":[{"type":"text","text":"A SwiftUI view that displays the position of the Input Entity relative to a specified root point."}],"type":"topic","kind":"symbol","title":"InputEntityPositionView","identifier":"doc:\/\/robokit.RoboKit\/documentation\/RoboKit\/InputEntityPositionView","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"InputEntityPositionView"}]}}}