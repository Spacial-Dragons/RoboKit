{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This module leverages ARKit to track one or more reference images added to an AR Resource Group in your asset catalog. It exposes two main properties: "},{"type":"codeVoice","code":"rootTransform"},{"type":"text","text":", which represents the calculated center of all tracked images, and "},{"code":"trackedImagesTransform","type":"codeVoice"},{"text":", which represents the positions of each individual image.","type":"text"}]},{"type":"heading","anchor":"Setup","level":2,"text":"Setup"},{"anchor":"Configure-Permissions","type":"heading","level":3,"text":"Configure Permissions"},{"type":"paragraph","inlineContent":[{"text":"Add the following key to your app’s Info.plist file:","type":"text"}]},{"type":"codeListing","code":["<key>NSWorldSensingUsageDescription<\/key>","<string>This app requires world sensing capabilities to track reference images.<\/string>"],"syntax":"xml"},{"type":"heading","level":3,"text":"Create AR Reference Image Group","anchor":"Create-AR-Reference-Image-Group"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Open Xcode and go to your asset catalog."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a new "},{"inlineContent":[{"type":"text","text":"AR Resource Group"}],"type":"strong"},{"type":"text","text":" (e.g., “AR Resources”)."}]}]},{"content":[{"inlineContent":[{"text":"Add your tracking images and set their ","type":"text"},{"type":"strong","inlineContent":[{"text":"physical size","type":"text"}]},{"type":"text","text":" correctly."}],"type":"paragraph"}]}]},{"level":3,"text":"Define Tracking Images in Code","type":"heading","anchor":"Define-Tracking-Images-in-Code"},{"inlineContent":[{"type":"text","text":"Each image should be described using its name and a root offset from the reference point in RealityKit coordinates:"}],"type":"paragraph"},{"code":["import RoboKit","","let trackingImages: [TrackingImage] = [","    TrackingImage(imageName: \"TrackingImage-1\", rootOffset: .init(x: -0.1135, y: 0, z: 0.175)),","    TrackingImage(imageName: \"TrackingImage-2\", rootOffset: .init(x: 0.1135, y: 0, z: -0.175))","]"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"identifier":"RealityKit-Coordinate-System.png","type":"image"}]},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tracking image quality is critical. Avoid compressed images, images with too few or too many geometric features, or with repeating patterns."}]}],"style":"important"},{"name":"Important","content":[{"inlineContent":[{"text":"Ensure all tracking images share the same physical orientation.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"important"},{"style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"If using multiple images, the "},{"code":"rootOffset","type":"codeVoice"},{"type":"text","text":" values are used to calculate the center. If using one image, set its offset to "},{"code":".zero","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside"},{"level":3,"text":"Initialize Image Tracker","type":"heading","anchor":"Initialize-Image-Tracker"},{"inlineContent":[{"type":"text","text":"Initialize the "},{"identifier":"doc:\/\/robokit.RoboKit\/documentation\/RoboKit\/ImageTracker","isActive":true,"type":"reference"},{"type":"text","text":" by providing the resource group name and your array of tracking images:"}],"type":"paragraph"},{"code":["@State private var imageTracker: RoboKit.ImageTracker = .init(","    arResourceGroupName: \"AR Resources\",","    images: trackingImages",")"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":2,"anchor":"Usage","text":"Usage"},{"level":3,"anchor":"Root-Transform","type":"heading","text":"Root Transform"},{"type":"paragraph","inlineContent":[{"text":"Represents the central position between all tracked images.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":[".onChange(of: imageTracker.rootTransform) {","    print(imageTracker.rootTransform)","}"]},{"type":"heading","text":"Tracked Images Transform","level":3,"anchor":"Tracked-Images-Transform"},{"inlineContent":[{"text":"Represents the positions of each tracked image:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".onChange(of: imageTracker.trackedImagesTransform) {","    print(imageTracker.trackedImagesTransform)","}"]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"These values update approximately once per second.","type":"text"}]}],"type":"aside","name":"Note"},{"style":"warning","name":"Warning","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Image tracking is not supported in the simulator."}]}]},{"style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"On visionOS, only one image can be tracked at a time, even if more are visible.","type":"text"}]}],"name":"Important"}]}],"sections":[],"metadata":{"modules":[{"name":"RoboKit"}],"role":"article","title":"Image Tracker","images":[{"identifier":"ImageTrackerModuleCard.png","type":"card"}],"roleHeading":"Article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/robokit.RoboKit\/documentation\/RoboKit\/ImageTrackerModule"},"kind":"article","hierarchy":{"paths":[["doc:\/\/robokit.RoboKit\/documentation\/RoboKit"]]},"abstract":[{"type":"text","text":"The Image Tracker module provides functionality for detecting and tracking images in the physical environment using ARKit and visionOS."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/robokit\/imagetrackermodule"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://robokit.RoboKit/documentation/RoboKit/ImageTracker":{"abstract":[{"type":"text","text":"The Image Tracker module provides functionality for detecting and tracking images"},{"text":" ","type":"text"},{"text":"in the physical environment using ARKit and visionOS.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"A class responsible for tracking images using ARKit and providing corresponding transformation data."},{"type":"text","text":" "},{"text":"It handles the initialization of AR sessions, image tracking, and updates for tracked anchors.","type":"text"}],"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ImageTracker"}],"identifier":"doc:\/\/robokit.RoboKit\/documentation\/RoboKit\/ImageTracker","title":"ImageTracker","url":"\/documentation\/robokit\/imagetracker","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ImageTracker"}]},"ImageTrackerModuleCard.png":{"type":"image","identifier":"ImageTrackerModuleCard.png","alt":null,"variants":[{"url":"\/images\/robokit.RoboKit\/ImageTrackerModuleCard.png","traits":["1x","light"]}]},"RoboKitLogo.png":{"type":"image","identifier":"RoboKitLogo.png","alt":"RoboKit logo.","variants":[{"url":"\/images\/robokit.RoboKit\/RoboKitLogo.png","traits":["1x","light"]},{"url":"\/images\/robokit.RoboKit\/RoboKitLogo~dark.png","traits":["1x","dark"]}]},"RealityKit-Coordinate-System.png":{"type":"image","identifier":"RealityKit-Coordinate-System.png","alt":"RealityKit coordinate system","variants":[{"url":"\/images\/robokit.RoboKit\/RealityKit-Coordinate-System.png","traits":["1x","light"]}]},"doc://robokit.RoboKit/documentation/RoboKit":{"role":"collection","url":"\/documentation\/robokit","title":"RoboKit","images":[{"type":"icon","identifier":"RoboKitLogo.png"}],"type":"topic","abstract":[{"type":"text","text":"RoboKit is a framework designed to facilitate the integration between visionOS applications and robotics software."}],"kind":"symbol","identifier":"doc:\/\/robokit.RoboKit\/documentation\/RoboKit"}}}