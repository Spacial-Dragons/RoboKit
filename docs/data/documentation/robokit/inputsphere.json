{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/robokit.RoboKit\/documentation\/RoboKit\/InputSphere"},"sections":[],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Input Sphere module creates a virtual sphere that can be positioned and rotated in 3D space to represent the desired pose (position and orientation) of a robot’s end effector. This module provides coordinate transformations between visionOS (RealityKit) and ROS (Robot Operating System) coordinate systems, making it easy to integrate with robotic applications."}]},{"text":"Setup","level":2,"type":"heading","anchor":"Setup"},{"text":"Initialize Input Sphere Manager","type":"heading","anchor":"Initialize-Input-Sphere-Manager","level":3},{"inlineContent":[{"text":"Create an instance of the ","type":"text"},{"identifier":"doc:\/\/robokit.RoboKit\/documentation\/RoboKit\/InputSphereManager","type":"reference","isActive":true},{"text":" to track and update the position and orientation of the Input Sphere:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import RoboKit","","@State private var inputSphereManager = InputSphereManager()"]},{"text":"Add Input Sphere to RealityKit Scene","anchor":"Add-Input-Sphere-to-RealityKit-Scene","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Add the Input Sphere to your RealityKit scene with the appropriate parent and rootPoint entities:","type":"text"}]},{"syntax":"swift","code":[".onAppear {","    inputSphereManager.addInputSphere(parentEntity: parentEntity, rootPoint: rootPoint)","}"],"type":"codeListing"},{"type":"heading","anchor":"Usage","level":2,"text":"Usage"},{"text":"Control Input Sphere Position","type":"heading","anchor":"Control-Input-Sphere-Position","level":3},{"inlineContent":[{"text":"Update the position of the Input Sphere using a drag gesture:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Add Input Sphere Drag Gesture recognition and handling.",".inputSphereDragGesture(","    parentEntity: parentEntity,","    rootPoint: rootPoint,","    inputSphereManager: inputSphereManager",")"],"syntax":"swift","type":"codeListing"},{"type":"heading","anchor":"Control-Input-Sphere-Orientation","text":"Control Input Sphere Orientation","level":3},{"inlineContent":[{"type":"text","text":"Update the orientation of the Input Sphere using Euler angles:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Set orientation using roll, pitch, and yaw","inputSphereManager.inputSphereEulerAngles = [","    .roll: Float.pi \/ 4,   \/\/ 45 degrees","    .yaw: 0,","    .pitch: Float.pi \/ 6   \/\/ 30 degrees","]"]},{"type":"heading","text":"Track Input Sphere Position","level":3,"anchor":"Track-Input-Sphere-Position"},{"type":"paragraph","inlineContent":[{"text":"Monitor the position of the Input Sphere relative to a root point in your scene:","type":"text"}]},{"syntax":"swift","code":["\/\/ Get position in ROS coordinate system","if let position = inputSphereManager.getInputSpherePosition(relativeToRootPoint: rootEntity) {","    print(\"Input Sphere position (ROS): \\(position)\")","}"],"type":"codeListing"},{"text":"Track Input Sphere Orientation","anchor":"Track-Input-Sphere-Orientation","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Monitor the orientation of the Input Sphere relative to a root point in your scene:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Get position in ROS coordinate system","if let orientation = inputSphereManager.getInputSphereRotation(relativeToRootPoint: rootEntity) {","    print(\"Input Sphere orientation (ROS): \\(orientation)\")","}"]},{"text":"Display Input Sphere Data","type":"heading","level":3,"anchor":"Display-Input-Sphere-Data"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"identifier":"doc:\/\/robokit.RoboKit\/documentation\/RoboKit\/InputSpherePositionView","isActive":true,"type":"reference"},{"type":"text","text":" to your SwiftUI interface to display the current position:"}]},{"type":"codeListing","syntax":"swift","code":["InputSpherePositionView(relativeToRootPoint: rootEntity)"]},{"type":"heading","level":3,"anchor":"Enable-Interactive-Control","text":"Enable Interactive Control"},{"inlineContent":[{"text":"Allow users to adjust the Input Sphere using the rotation sliders:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["VStack {","    InputSphereRotationSlider(eulerAngle: .roll)","    InputSphereRotationSlider(eulerAngle: .pitch)","    InputSphereRotationSlider(eulerAngle: .yaw)","}"],"syntax":"swift"},{"type":"aside","name":"Important","content":[{"inlineContent":[{"type":"text","text":"Remember that the Input Sphere uses different coordinate systems for RealityKit and ROS. Position and rotation values are automatically converted when using the appropriate getter methods."}],"type":"paragraph"}],"style":"important"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/robokit\/inputsphere"]}],"metadata":{"images":[{"type":"card","identifier":"InputSphereCard.png"}],"modules":[{"name":"RoboKit"}],"roleHeading":"Article","role":"article","title":"Input Sphere"},"hierarchy":{"paths":[["doc:\/\/robokit.RoboKit\/documentation\/RoboKit"]]},"abstract":[{"text":"The Input Sphere module provides a visual and interactive way to control a robot’s end effector in 3D space using visionOS.","type":"text"}],"references":{"doc://robokit.RoboKit/documentation/RoboKit/InputSpherePositionView":{"navigatorTitle":[{"kind":"identifier","text":"InputSpherePositionView"}],"url":"\/documentation\/robokit\/inputspherepositionview","type":"topic","kind":"symbol","identifier":"doc:\/\/robokit.RoboKit\/documentation\/RoboKit\/InputSpherePositionView","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"InputSpherePositionView","kind":"identifier"}],"title":"InputSpherePositionView","role":"symbol","abstract":[{"type":"text","text":"A SwiftUI view that displays the position of the Input Sphere relative to a specified root point."}]},"doc://robokit.RoboKit/documentation/RoboKit/InputSphereManager":{"type":"topic","url":"\/documentation\/robokit\/inputspheremanager","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InputSphereManager","kind":"identifier"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/robokit.RoboKit\/documentation\/RoboKit\/InputSphereManager","title":"InputSphereManager","abstract":[{"type":"text","text":"A class responsible for managing the Input Sphere, which represents the desired position"},{"type":"text","text":" "},{"text":"and orientation of a robot’s end effector in a 3D environment.","type":"text"}],"navigatorTitle":[{"text":"InputSphereManager","kind":"identifier"}]},"doc://robokit.RoboKit/documentation/RoboKit":{"kind":"symbol","title":"RoboKit","url":"\/documentation\/robokit","role":"collection","images":[{"identifier":"RoboKitLogo.png","type":"icon"}],"type":"topic","identifier":"doc:\/\/robokit.RoboKit\/documentation\/RoboKit","abstract":[{"type":"text","text":"RoboKit is a framework designed to facilitate the integration between visionOS applications and robotics software."}]},"InputSphereCard.png":{"identifier":"InputSphereCard.png","variants":[{"url":"\/images\/robokit.RoboKit\/InputSphereCard.png","traits":["1x","light"]}],"alt":null,"type":"image"},"RoboKitLogo.png":{"identifier":"RoboKitLogo.png","variants":[{"url":"\/images\/robokit.RoboKit\/RoboKitLogo.png","traits":["1x","light"]},{"traits":["1x","dark"],"url":"\/images\/robokit.RoboKit\/RoboKitLogo~dark.png"}],"alt":"RoboKit logo.","type":"image"}}}